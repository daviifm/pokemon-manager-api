// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Treinador: quem captura e carrega os Pokémons (time de no máximo 6).
model Trainer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(150)
  email     String    @unique @db.VarChar(255) // @unique => erro P2002 em e-mail duplicado
  city      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  pokemons  Pokemon[]

  @@map("trainers")
}

// Pokémon capturado/registrado. O `id` é um UUID (o mesmo Pikachu pode aparecer
// várias vezes, em times diferentes). O número da Pokédex identifica a ESPÉCIE
// (`pokedexNumber`) e por isso NÃO é único.
model Pokemon {
  id             String   @id @db.Uuid
  pokedexNumber  Int      @map("pokedex_number")
  name           String   @db.VarChar(100)
  types          String[] // 1 ou 2 tipos (ex: ["grass", "poison"])
  level          Int
  hp             Int
  attack         Int
  defense        Int
  specialAttack  Int      @map("special_attack")
  specialDefense Int      @map("special_defense")
  speed          Int
  spriteUrl      String?  @map("sprite_url")
  baseExperience Int?     @map("base_experience")
  height         Int?
  weight         Int?
  trainerId      String?  @map("trainer_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Se o treinador for removido, o Pokémon NÃO é apagado: trainer_id vira NULL
  // (volta a ser selvagem). Integridade referencial garantida pelo próprio banco.
  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([trainerId])
  @@index([name])
  @@map("pokemons")
}
