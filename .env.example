PORT=3333
NODE_ENV=development

# Credenciais do Banco de Dados PostgreSQL (lidas pelo docker-compose)
POSTGRES_USER=pokemanager
POSTGRES_PASSWORD=pokepassword
POSTGRES_DB=pokemanager_db
POSTGRES_PORT=5432

# pgAdmin (interface web do banco, em http://localhost:8080)
PGADMIN_DEFAULT_EMAIL=admin@pokemanager.com
PGADMIN_DEFAULT_PASSWORD=admin123

# URL do Banco (usada pelo Prisma quando a API roda FORA do Docker, na sua máquina)
DATABASE_URL="postgresql://pokemanager:pokepassword@localhost:5432/pokemanager_db?schema=public"

# Qual implementação de banco a API usa: prisma (padrão) | pg (driver nativo) | memory
DB_DRIVER=prisma

# true = consulta a PokéAPI real; false = gateway em memória (offline/testes)
USE_EXTERNAL_API=true
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT_MS=3000
